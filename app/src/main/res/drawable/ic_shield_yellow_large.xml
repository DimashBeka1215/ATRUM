<?xml version="1.0" encoding="utf-8"?>
<!-- Большой жёлтый shield с subtle fill — для hero на OAuth warning -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="140dp"
    android:height="160dp"
    android:viewportWidth="140"
    android:viewportHeight="160">

    <!-- Внутренний faint yellow fill -->
    <path
        android:fillColor="#1AFFB454"
        android:pathData="M70,10 L125,28 L125,80 C125,118 102,148 70,158 C38,148 15,118 15,80 L15,28 Z" />

    <!-- Outer outline -->
    <path
        android:fillColor="#00000000"
        android:pathData="M70,10 L125,28 L125,80 C125,118 102,148 70,158 C38,148 15,118 15,80 L15,28 Z"
        android:strokeColor="@color/warning"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.4" />

    <!-- Inner thin accent -->
    <path
        android:fillColor="#00000000"
        android:pathData="M70,20 L116,34 L116,80 C116,113 96,138 70,147 C44,138 24,113 24,80 L24,34 Z"
        android:strokeAlpha="0.50"
        android:strokeColor="@color/warning"
        android:strokeWidth="0.8" />
</vector>
