<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Фон — тёмная пилюля с рамкой -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_elevated"/>
            <corners android:radius="10dp"/>
            <stroke android:width="0.5dp" android:color="@color/border"/>
        </shape>
    </item>

    <!-- Заполнение прогресса — акцентный цвет -->
    <item android:id="@android:id/progress">
        <clip android:clipOrientation="horizontal" android:gravity="start">
            <shape android:shape="rectangle">
                <solid android:color="@color/accent"/>
                <corners android:radius="10dp"/>
            </shape>
        </clip>
    </item>

</layer-list>
