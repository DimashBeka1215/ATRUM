<?xml version="1.0" encoding="utf-8"?>
<!--
    Glass-вариант плашки лимита (когда активны обои, поверх фото).
    По правилам glass-режима (§0/§5): полупрозрачный ТЁМНЫЙ оверлей + янтарная
    обводка, а текст/иконка поверх — янтарные (@color/warning). Никаких
    непрозрачных surface/bg здесь не используется намеренно.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#8C000000" />
    <stroke android:width="1dp" android:color="#80FFB454" />
    <corners android:radius="12dp" />
</shape>
