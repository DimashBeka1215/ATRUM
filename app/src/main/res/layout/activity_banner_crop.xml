<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnCancel"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_cancel" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="@string/header_settings_crop_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/btnDone"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="9dp"
            android:src="@drawable/ic_check"
            app:tint="@color/accent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_done" />
    </LinearLayout>

    <com.atrum.chat.BannerCropView
        android:id="@+id/cropView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="8dp"
        android:text="100%" />

    <SeekBar
        android:id="@+id/seekZoom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent"
        android:progressBackgroundTint="@color/surface_elevated" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:id="@+id/btnSafe"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_pub_outline"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvSafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bcrop_safe_show"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_pub_outline">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bcrop_reset"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
