<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- ═══ Full-screen wallpaper ═══ -->
    <ImageView
        android:id="@+id/iv_chat_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- ═══ Cinematic top scrim (glass mode only) ═══ -->
    <View
        android:id="@+id/view_scrim_top"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_top"
        android:visibility="gone"/>

    <!-- ═══ Cinematic bottom scrim (glass mode only) ═══ -->
    <View
        android:id="@+id/view_scrim_bottom"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/chat_root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ═══ Header / Toolbar ═══ -->
        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="10dp"
            android:elevation="0dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/cd_back"
                android:padding="9dp"
                app:tint="@color/text_primary"/>

            <FrameLayout
                android:id="@+id/v_avatar_container"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_placeholder"/>

                <TextView
                    android:id="@+id/tv_partner_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_partner_avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.Circle"/>

                <View
                    android:id="@+id/v_online_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_online_indicator"
                    android:visibility="gone"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_display_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_chat_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chat_subtitle_encrypted"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:indeterminateTint="@color/accent"/>

            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_more_vert"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/cd_settings"
                android:padding="9dp"
                app:tint="@color/text_secondary"/>
        </LinearLayout>

        <!-- Тонкий разделитель — скрывается когда есть обои -->
        <View
            android:id="@+id/header_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/warning_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_warning"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="12dp"
                android:layout_marginTop="1dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_warning_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/warning"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_warning_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/warning_action_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:id="@+id/warning_remember"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:background="@drawable/bg_remember_chip_off"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/warning_remember_check"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/ic_check"
                            android:contentDescription="@null"
                            app:tint="@color/warning"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/remember_choice"
                            android:textColor="@color/warning"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tv_warning_action"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="@string/btn_update_token"
                        android:textColor="@color/accent"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_button_outline_neon"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"
                android:alpha="0"/>

            <LinearLayout
                android:id="@+id/loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@color/bg">

                <ProgressBar
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:indeterminateTint="@color/accent"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/chat_loading"
                    android:textColor="@color/text_tertiary"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_empty_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/chat_empty"
                android:textColor="@color/text_tertiary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"/>


            <com.atrum.chat.BackdropBlurView
                android:id="@+id/reply_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:clipToOutline="true"
                android:background="@android:color/transparent"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tv_reply_sender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:layout_marginBottom="1dp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tv_reply_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:alpha="0.8"/>

                    <LinearLayout
                        android:id="@+id/ll_reply_photo_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_image_outline"
                            app:tint="@color/accent"
                            android:layout_marginEnd="4dp" />
                        <TextView
                            android:id="@+id/tv_reply_photo_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:text="@string/reply_photo_label" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_reply_thumb"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.RoundedImage" />

                <ImageButton
                    android:id="@+id/btn_cancel_reply"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_cancel_reply"
                    android:padding="7dp"
                    android:layout_marginStart="4dp"
                    app:tint="#B3FFFFFF"/>
            </com.atrum.chat.BackdropBlurView>

            <!-- ═══ Мут (read-only) — крупная плашка по центру, DESIGN.md §10: кастомная,
                 не системный диалог. Занимает всю область сообщений, пока не свёрнута
                 (см. ChatActivity.applySelfMuteState) ═══ -->
            <FrameLayout
                android:id="@+id/muted_banner_large"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/bg"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/btn_muted_banner_collapse"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_muted_banner_collapse"
                    app:tint="@color/text_tertiary"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="24dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_warning"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="24dp">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginBottom="14dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_muted_icon_circle"/>

                        <ImageView
                            android:id="@+id/iv_muted_banner_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_bell_off"
                            app:tint="@color/warning"
                            android:contentDescription="@null"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_muted_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muted_banner_title"
                        android:textColor="@color/warning"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tv_muted_banner_until"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginBottom="12dp"
                        tools:text="до 12.05.2028, 20:00"/>

                    <View
                        android:layout_width="120dp"
                        android:layout_height="1dp"
                        android:background="@color/border"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muted_banner_reason_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tv_muted_banner_reason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:layout_marginBottom="14dp"
                        tools:text="слишком много спама в общем чате"/>

                    <LinearLayout
                        android:id="@+id/muted_evidence_section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="120dp"
                            android:layout_height="1dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@color/border"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/muted_banner_evidence_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginBottom="10dp"/>

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="170dp"
                            android:background="@drawable/bg_warning_input"
                            android:layout_marginBottom="14dp">

                            <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <LinearLayout
                                    android:id="@+id/muted_evidence_feed"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="10dp" />
                            </ScrollView>
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/muted_banner_input_hidden"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:gravity="center"/>
                </LinearLayout>
            </FrameLayout>

            <!-- ═══ Мут — свёрнутая компактная версия (тап разворачивает обратно) ═══ -->
            <LinearLayout
                android:id="@+id/muted_banner_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="@drawable/bg_warning"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/cd_muted_banner_expand"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_bell_off"
                    app:tint="@color/warning"
                    android:contentDescription="@null"/>

                <TextView
                    android:id="@+id/tv_muted_banner_compact_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/warning"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Вы заглушены до 12.05.2028, 20:00"/>

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_chevron_down"
                    android:rotation="180"
                    app:tint="@color/warning"
                    android:contentDescription="@null"/>
            </LinearLayout>

        </FrameLayout>

        <!-- ═══ Sticker panel container (visibility=gone by default) ═══ -->
        <FrameLayout
            android:id="@+id/sticker_panel_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:visibility="gone"/>

        <!-- ═══ Подсказки стикеров по эмодзи (gone по умолчанию; высота задаётся в коде) ═══ -->
        <LinearLayout
            android:id="@+id/sticker_suggestions_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_sticker_suggestions"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:clipToPadding="false"
                android:scrollbars="vertical"/>
        </LinearLayout>

        <!-- ═══ Плашка лимита Relay — выезжает над полем ввода ═══ -->
        <LinearLayout
            android:id="@+id/transport_limit_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_transport_limit_banner"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="2dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_transport_limit_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_clock"
                app:tint="@color/warning_on" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_transport_limit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/transport_limit_title"
                    android:textColor="@color/warning_on"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_transport_limit_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/warning_on"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Жёлтая плашка «скоро лимит записи» — над полем ввода ═══ -->
        <LinearLayout
            android:id="@+id/voice_limit_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_voice_limit_banner"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="2dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="9dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iv_voice_limit_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning"
                app:tint="@color/voice_limit_on" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_voice_limit_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/voice_limit_title"
                    android:textColor="@color/voice_limit_on"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tv_voice_limit_msg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/voice_limit_msg"
                    android:textColor="@color/voice_limit_on"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Панель выбранных фото перед отправкой -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/staged_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <!-- ═══ Input area — pill container ═══ -->
        <LinearLayout
            android:id="@+id/input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp"
            android:gravity="center_vertical">

            <!-- Pill container: attach + EditText + send -->
            <LinearLayout
                android:id="@+id/input_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_chat_input_pill"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btn_attach"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_attach"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/cd_attach"
                    android:padding="11dp"
                    app:tint="@color/text_secondary"/>

                <ImageButton
                    android:id="@+id/btn_sticker"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_sticker"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/sticker_cd_button"
                    android:padding="11dp"
                    app:tint="@color/text_secondary"/>

                <ImageButton
                    android:id="@+id/btn_rec_delete"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_trash_menu"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/voice_delete_cd"
                    android:padding="12dp"
                    android:visibility="gone"
                    app:tint="@color/error"/>

                <LinearLayout
                    android:id="@+id/recording_row"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:visibility="gone">
                    <View
                        android:id="@+id/rec_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_voice_circle_rec" />
                    <TextView
                        android:id="@+id/tv_rec_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="0:00"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/tv_rec_hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/voice_slide_to_cancel"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                    <com.atrum.chat.WaveformView
                        android:id="@+id/waveform_record"
                        android:layout_width="0dp"
                        android:layout_height="32dp"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="6dp"
                        android:visibility="gone" />
                </LinearLayout>

                <EditText
                    android:id="@+id/et_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    android:hint="@string/hint_message"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:background="@android:color/transparent"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="10dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4"
                    android:imeOptions="actionSend"
                    android:textSize="15sp"
                    android:importantForAutofill="no"/>

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_send"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/cd_send"
                    android:padding="11dp"
                    app:tint="@color/white"/>

                <ImageButton
                    android:id="@+id/btn_voice"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_mic"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/voice_record_cd"
                    android:padding="11dp"
                    android:visibility="gone"
                    app:tint="@color/white"/>

                <ImageButton
                    android:id="@+id/btn_rec_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_pause"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/voice_pause_cd"
                    android:padding="11dp"
                    android:visibility="gone"
                    app:tint="@color/accent"/>

                <ImageButton
                    android:id="@+id/btn_rec_send"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/ic_send"
                    android:background="@drawable/bg_send_button"
                    android:contentDescription="@string/cd_send"
                    android:padding="11dp"
                    android:visibility="gone"
                    app:tint="@color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Selection bar -->
        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_selection_close"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_close"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/btn_cancel"
                android:padding="10dp"
                app:tint="@color/text_secondary"/>

            <TextView
                android:id="@+id/tv_selection_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="10dp"
                android:text="@string/selection_count_fmt"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>

            <ImageButton
                android:id="@+id/btn_selection_copy"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_copy_menu"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_copy"
                android:padding="10dp"
                app:tint="@color/text_secondary"/>

            <ImageButton
                android:id="@+id/btn_selection_forward"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_forward_menu"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_reply"
                android:padding="10dp"
                android:layout_marginHorizontal="4dp"
                app:tint="@color/text_secondary"/>

            <ImageButton
                android:id="@+id/btn_selection_delete"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_trash_menu"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_delete"
                android:padding="10dp"
                app:tint="@color/warning"/>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>
