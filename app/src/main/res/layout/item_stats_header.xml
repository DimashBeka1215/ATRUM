<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="4dp">

    <!-- Сегментированный переключатель периода — тот же стиль, что demo_role_toggle
         в activity_partner_profile.xml (bg_input + bg_chip_selected/bg_chip_default). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/seg_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_default"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/stats_period_day"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seg_week"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_selected"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/stats_period_week"
            android:textColor="@color/accent_light"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seg_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_default"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/stats_period_month"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/seg_year"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_chip_default"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:text="@string/stats_period_year"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Карточка: активность за период -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/stats_activity_title"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tv_chart_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/bar_chart"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:gravity="bottom"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/bar_labels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Карточка: активность по часам суток -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_card"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/stats_hourly_title"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/tv_peak_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:textColor="@color/accent_light"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/hour_chart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="bottom"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Сводные карточки -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/stat_card_total"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp">
            <TextView android:id="@+id/stat_total" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="@string/stats_stat_total" android:textColor="@color/text_tertiary" android:textSize="9.5sp" android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp">
            <TextView android:id="@+id/stat_per_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="@string/stats_stat_per_day" android:textColor="@color/text_tertiary" android:textSize="9.5sp" android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp">
            <TextView android:id="@+id/stat_peak_hour" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="@string/stats_stat_peak_hour" android:textColor="@color/text_tertiary" android:textSize="9.5sp" android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp">
            <TextView android:id="@+id/stat_active_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="@string/stats_stat_active_days" android:textColor="@color/text_tertiary" android:textSize="9.5sp" android:gravity="center" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_gesture_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="24dp"
        android:gravity="center"
        android:text="@string/stats_gesture_hint"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp"
        android:lineSpacingExtra="2dp" />

</LinearLayout>
