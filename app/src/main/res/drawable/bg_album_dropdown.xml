<?xml version="1.0" encoding="utf-8"?>
<!-- Фон выпадающего списка альбомов. Непрозрачная приподнятая поверхность из токена
     (корректна в светлой/тёмной), скруглённая, с тонкой рамкой. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
