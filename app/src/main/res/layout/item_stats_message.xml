<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="8dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="9dp">

    <TextView
        android:id="@+id/tv_msg_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_tertiary"
        android:textSize="10.5sp" />

    <!-- Ветка ответа — цитата оригинала (по имени+первым 120 симв., см. StatsUtil.findQuotedOriginal).
         Тот же визуальный паттерн, что и quote_block в item_message_other.xml — левая полоса
         акцентом + bg_quote_other, для согласованности (см. CLAUDE.md §11). -->
    <LinearLayout
        android:id="@+id/ll_msg_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_quote_other"
        android:paddingHorizontal="8dp"
        android:paddingVertical="5dp"
        android:visibility="gone">

        <View
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:minHeight="24dp"
            android:layout_marginEnd="8dp"
            android:background="@color/accent_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_msg_quote_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/accent_light"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_msg_quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/text_tertiary"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_msg_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Фото — миниатюра, тап открывает полноэкранный просмотрщик. -->
    <FrameLayout
        android:id="@+id/fl_msg_photo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="6dp"
        android:visibility="gone">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_msg_photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/surface_elevated"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.RoundedImage" />

    </FrameLayout>

    <!-- Голосовое — воспроизведение прямо в списке (см. VoicePlayer, тот же паттерн, что и
         в ленте сообщений-оснований мута, ChatActivity.addMuteEvidenceBubble). -->
    <LinearLayout
        android:id="@+id/ll_msg_voice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_msg_voice_play"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_play"
            app:tint="@color/accent"
            android:contentDescription="@null" />

        <FrameLayout
            android:layout_width="70dp"
            android:layout_height="3dp"
            android:layout_marginHorizontal="8dp"
            android:background="@color/border">

            <View
                android:id="@+id/v_msg_voice_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/accent" />

        </FrameLayout>

        <TextView
            android:id="@+id/tv_msg_voice_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>
