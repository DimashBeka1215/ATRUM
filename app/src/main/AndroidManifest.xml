<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Чтобы Service мог открыть Activity поверх Custom Tabs после успеха OAuth -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Системная биометрия (отпечаток). Приложение не хранит биометрию,
         только вызывает системный BiometricPrompt телефона. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Bluetooth — локальный офлайн-путь сообщений (BLE между двумя телефонами). -->
    <!-- Android 12+ (API 31+): -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- Android 11 и ниже (API ≤ 30): -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- На API ≤ 30 поиск устройств требует геолокацию (только для discovery, не для координат). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Камера — только для сканера QR (Bluetooth-подключение по QR). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Сохранение QR в галерею на Android 9 и ниже (на 10+ — через MediaStore без разрешения) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Своя галерея выбора фото (читает MediaStore). Приватность: на Android 14+
         поддерживаем ЧАСТИЧНЫЙ доступ (пользователь сам отмечает видимые фото);
         при отказе — откат на системный выбор без каких-либо разрешений. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:largeHeap="true"
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AtrumChat"
        tools:targetApi="33">

        <activity
            android:name=".IntroActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatsListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ModsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BatteryOptimizationActivity"
            android:exported="false" />

        <activity
            android:name=".CreditsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CreateChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".JoinChatActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Deep-link приглашения: открывается штатной камерой/браузером по atrum://join -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="atrum" android:host="join" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ImageViewActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PersonalizationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WallpaperPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EULA — пользовательское соглашение, показывается при первом запуске -->
        <activity
            android:name=".EulaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Профиль собеседника -->
        <activity
            android:name=".PartnerProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Полный список медиа (фото/ссылки/голосовые) из профиля -->
        <activity
            android:name=".MediaListActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Экран QR-приглашения (стилизованный QR + поделиться/сканировать) -->
        <activity
            android:name=".InviteQrActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Издатель списка реле (скрытый, только при наличии ключа) -->
        <activity
            android:name=".PublisherActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Гейт перед издателем (пароль) -->
        <activity
            android:name=".PublisherGateActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Кастомный кадратор шапки (замена uCrop на этом пути) -->
        <activity
            android:name=".BannerCropActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <!-- Экран краша — открывается вместо системного диалога "Приложение остановлено" -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AtrumChat" />


        <!-- HeaderSettingsActivity — настройка баннера профиля -->
        <activity
            android:name=".HeaderSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".TesterSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stickers.StickerSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stickers.StickerGuideActivity"
            android:exported="false"
            android:theme="@style/Theme.AtrumChat" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChangePinActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- uCrop activity для кропа аватарок -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Фоновый сервис пушей: тихо опрашивает реле и шлёт анонимный пуш о новом сообщении -->
        <service
            android:name=".MessageWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Перезапуск сервиса после перезагрузки телефона -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Шеринг картинки QR-приглашения через content:// -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
