<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back_desc" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/pub_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ── Есть ключ: издатель (богатый контент — скролл) ── -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/llHasKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvNotBaked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pub_no_pubkey_baked"
                    android:textColor="@color/warning"
                    android:textSize="12.5sp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPubKeyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pub_pubkey_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPubKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pub_field"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/btnCopyPub"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:paddingHorizontal="18dp"
                    android:gravity="center"
                    android:text="@string/pub_copy"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pub_outline"
                    android:layout_marginBottom="18dp" />

                <TextView
                    android:id="@+id/tvCurrentVer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pub_added_relays"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/llRelays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp">

                    <EditText
                        android:id="@+id/etNewRelay"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pub_field"
                        android:padding="11dp"
                        android:hint="@string/pub_add_relay_hint"
                        android:textColorHint="@color/text_quaternary"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="monospace"
                        android:inputType="textUri"
                        android:maxLines="1" />

                    <ImageView
                        android:id="@+id/btnAddRelay"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:padding="11dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/accent"
                        android:background="@drawable/bg_pub_field"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnPublish"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="@string/pub_publish"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_pub_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvPublishStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp"
                    android:gravity="center"
                    android:layout_marginBottom="18dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnDeleteKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="10dp"
                    android:text="@string/pub_delete_key"
                    android:textColor="@color/error"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>

        <!-- ── Нет ключа: форма по центру, предупреждение внизу ── -->
        <LinearLayout
            android:id="@+id/llNoKey"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pub_no_key_info"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/etKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pub_field"
                    android:padding="12dp"
                    android:hint="@string/pub_key_hint"
                    android:textColorHint="@color/text_quaternary"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:inputType="textPassword"
                    android:maxLines="2"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btnSaveKey"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="@string/pub_save_key"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_pub_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/btnGenPair"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="@string/pub_gen_pair"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:background="@drawable/bg_pub_outline" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="22dp"
                android:paddingTop="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="9dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warning"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pub_warn_lose_key"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</LinearLayout>
