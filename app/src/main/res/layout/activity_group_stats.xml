<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:background="@color/bg">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_primary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/btn_back_desc" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="@string/group_stats_title"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/border" />

        <!-- Контентная область: три раздела оверлеем, виден один. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Раздел «Участники» -->
            <LinearLayout
                android:id="@+id/section_users"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:text="@string/group_stats_sort_label"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                    android:id="@+id/swipe_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_stats_users"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="82dp"
                        android:scrollbars="vertical" />
                </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
            </LinearLayout>

            <!-- Раздел «История модерации» -->
            <FrameLayout
                android:id="@+id/section_mute_history"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_mute_history"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="82dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/tv_mute_history_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/mute_history_empty"
                    android:textColor="@color/text_tertiary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Раздел «Беседа» -->
            <ScrollView
                android:id="@+id/section_chat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="82dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp">

                    <!-- Переключатель периода -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:id="@+id/chip_all"
                            style="@style/StatsChip"
                            android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/tv_chip_all" style="@style/StatsChipText" android:text="@string/stats_chip_all" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_month"
                            style="@style/StatsChip"
                            android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/tv_chip_month" style="@style/StatsChipText" android:text="@string/stats_chip_month" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_week"
                            style="@style/StatsChip">
                            <TextView android:id="@+id/tv_chip_week" style="@style/StatsChipText" android:text="@string/stats_chip_week" />
                        </LinearLayout>

                        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btn_calendar"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:padding="8dp"
                            android:src="@drawable/ic_calendar_thin"
                            app:tint="@color/accent_light"
                            android:background="@drawable/bg_stats_pill"
                            android:contentDescription="@string/stats_pick_range" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_range_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <!-- Инлайн-календарь (скрыт, тап по кнопке раскрывает) -->
                    <LinearLayout
                        android:id="@+id/cal_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:padding="10dp"
                        android:background="@drawable/bg_settings_card"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageButton android:id="@+id/cal_prev" android:layout_width="30dp" android:layout_height="30dp" android:padding="7dp" android:src="@drawable/ic_chevron_right" android:rotation="180" app:tint="@color/accent_light" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/stats_pick_range" />
                            <TextView android:id="@+id/cal_month" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/text_primary" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                            <ImageButton android:id="@+id/cal_next" android:layout_width="30dp" android:layout_height="30dp" android:padding="7dp" android:src="@drawable/ic_chevron_right" app:tint="@color/accent_light" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/stats_pick_range" />
                        </LinearLayout>

                        <LinearLayout android:id="@+id/cal_grid" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <!-- Счётчики -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false">

                        <LinearLayout style="@style/StatsCard" android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/tv_now" style="@style/StatsCardNum" android:textColor="@color/accent_light" />
                            <TextView style="@style/StatsCardLabel" android:text="@string/stats_now" />
                        </LinearLayout>
                        <LinearLayout style="@style/StatsCard" android:layout_marginEnd="6dp">
                            <TextView android:id="@+id/tv_joined" style="@style/StatsCardNum" android:textColor="@color/accent" />
                            <TextView style="@style/StatsCardLabel" android:text="@string/stats_joined" />
                        </LinearLayout>
                        <LinearLayout style="@style/StatsCard">
                            <TextView android:id="@+id/tv_left" style="@style/StatsCardNum" android:textColor="@color/accent_dark" />
                            <TextView style="@style/StatsCardLabel" android:text="@string/stats_left" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Создана / пик -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp" android:background="@drawable/bg_settings_card" android:paddingHorizontal="12dp" android:paddingVertical="9dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/stats_created" android:textColor="@color/text_secondary" android:textSize="11sp" />
                        <TextView android:id="@+id/tv_created" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="11sp" />
                    </LinearLayout>

                    <!-- График: участники со временем -->
                    <TextView style="@style/StatsSectionLabel" android:text="@string/stats_members_over_time" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_card" android:padding="8dp">
                        <com.atrum.chat.StatsChartView
                            android:id="@+id/chart_line"
                            android:layout_width="match_parent"
                            android:layout_height="96dp" />
                    </FrameLayout>

                    <!-- График: приходы/уходы -->
                    <TextView style="@style/StatsSectionLabel" android:text="@string/stats_joins_leaves" />
                    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_settings_card" android:padding="8dp">
                        <com.atrum.chat.StatsChartView
                            android:id="@+id/chart_bars"
                            android:layout_width="match_parent"
                            android:layout_height="70dp" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_gravity="center_horizontal" android:layout_marginTop="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_legend_joins" android:textColor="@color/accent_light" android:textSize="10sp" android:layout_marginEnd="12dp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/stats_legend_leaves" android:textColor="@color/msg_self" android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Карточка деталей выбранного дня -->
                    <LinearLayout
                        android:id="@+id/detail_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="12dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_info_banner">
                        <TextView android:id="@+id/tv_detail_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/accent_light" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:text="@string/stats_detail_hint_title" />
                        <TextView android:id="@+id/tv_detail_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp" android:text="@string/stats_detail_hint_body" />
                    </LinearLayout>

                    <!-- Таймлайн событий -->
                    <TextView style="@style/StatsSectionLabel" android:text="@string/stats_events" />
                    <LinearLayout android:id="@+id/events_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="12dp" />
                </LinearLayout>
            </ScrollView>

            <!-- Раздел «Админы» -->
            <LinearLayout
                android:id="@+id/section_admins"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="10dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.06"
                        android:text="@string/admins_section_label"
                        android:textAllCaps="true"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp" />

                    <ImageButton
                        android:id="@+id/btn_add_admin"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:padding="7dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/accent_light"
                        android:background="@drawable/bg_stats_pill"
                        android:contentDescription="@string/admins_add" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_admins"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="82dp"
                    android:scrollbars="vertical" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Нижняя пилюля-переключатель (мокап одобрен): 3 иконки без подписей. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_stats_pill"
        android:padding="4dp">

        <ImageButton
            android:id="@+id/pill_users"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_people"
            app:tint="@color/accent_light"
            android:background="@drawable/bg_stats_pill_active"
            android:contentDescription="@string/group_stats_tab_users" />

        <ImageButton
            android:id="@+id/pill_moderation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_bell_off"
            app:tint="@color/text_tertiary"
            android:background="@android:color/transparent"
            android:contentDescription="@string/group_stats_tab_mute_history" />

        <ImageButton
            android:id="@+id/pill_chat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_chart_trend"
            app:tint="@color/text_tertiary"
            android:background="@android:color/transparent"
            android:contentDescription="@string/stats_tab_chat" />

        <ImageButton
            android:id="@+id/pill_admins"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/text_tertiary"
            android:background="@android:color/transparent"
            android:contentDescription="@string/admins_section_label" />
    </LinearLayout>

</FrameLayout>
