<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!--
        ScrollView + fillViewport — страховка на маленьких экранах/крупном системном
        шрифте (см. CLAUDE.md, адаптация под старые телефоны): в обычных условиях не
        активируется, gravity=center внутри работает как раньше.
    -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <ImageView
            android:layout_width="@dimen/lock_icon_size"
            android:layout_height="@dimen/lock_icon_size"
            android:src="@drawable/ic_lock"
            android:contentDescription="@null"
            android:layout_marginBottom="@dimen/lock_icon_margin_bottom"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/lock_title_size"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="@dimen/lock_hint_margin_bottom"/>

        <EditText
            android:id="@+id/et_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/lock_field"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:imeOptions="actionDone"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no"/>

        <Button
            android:id="@+id/btn_unlock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/lock_use_pin"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>

        <!-- Разделитель "или" — виден только если включён вход по отпечатку -->
        <LinearLayout
            android:id="@+id/or_divider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone">
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_or"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:layout_marginHorizontal="12dp"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/border"/>
        </LinearLayout>

        <!-- Кнопка входа по отпечатку — видна только если включён вход по отпечатку -->
        <LinearLayout
            android:id="@+id/btn_biometric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">
            <FrameLayout
                android:id="@+id/fp_circle"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/bg_biometric_circle"
                android:clipToOutline="true">
                <ImageView
                    android:id="@+id/iv_fingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_fingerprint"
                    android:tint="@color/accent"
                    android:padding="15dp"
                    android:contentDescription="@string/lock_use_fingerprint"/>
                <View
                    android:id="@+id/v_scan_line"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginHorizontal="9dp"
                    android:layout_gravity="top"
                    android:background="@drawable/bg_scan_line"/>
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_use_fingerprint"
                android:textColor="@color/accent_light"
                android:textSize="14sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- Плашка-объяснение про вход по отпечатку (скрыта, выезжает по тапу на "?") -->
    <LinearLayout
        android:id="@+id/card_fp_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="64dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_warning"
        android:padding="14dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_fingerprint"
            app:tint="@color/warning"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/biometric_how_title"
                android:textColor="@color/warning"
                android:fontFamily="sans-serif-medium"
                android:textSize="13sp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/biometric_how_body"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Минималистичный знак вопроса в правом нижнем углу -->
    <ImageButton
        android:id="@+id/btn_fp_help"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:padding="11dp"
        android:src="@drawable/ic_question"
        app:tint="@color/text_tertiary"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        android:contentDescription="@string/biometric_how_title"/>
</FrameLayout>
