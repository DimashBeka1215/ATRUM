<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/flBannerSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- Hero background: always visible, light/dark via drawable-night -->
                <View
                    android:id="@+id/vHeroBg"
                    android:layout_width="0dp"
                    android:layout_height="170dp"
                    android:background="@drawable/bg_hero_settings"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Banner photo overlaid on hero bg -->
                <ImageView
                    android:id="@+id/ivBanner"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/vHeroBg"
                    app:layout_constraintBottom_toBottomOf="@id/vHeroBg"
                    app:layout_constraintStart_toStartOf="@id/vHeroBg"
                    app:layout_constraintEnd_toEndOf="@id/vHeroBg"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@null" />

                <View
                    android:id="@+id/vBannerDimOverlay"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/vHeroBg"
                    app:layout_constraintBottom_toBottomOf="@id/vHeroBg"
                    app:layout_constraintStart_toStartOf="@id/vHeroBg"
                    app:layout_constraintEnd_toEndOf="@id/vHeroBg"
                    android:background="#25000000"
                    android:visibility="gone" />

                <!-- Gradient fade — always visible, dissolves hero into page bg -->
                <View
                    android:id="@+id/vBannerGradient"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="@id/vHeroBg"
                    app:layout_constraintBottom_toBottomOf="@id/vHeroBg"
                    app:layout_constraintStart_toStartOf="@id/vHeroBg"
                    app:layout_constraintEnd_toEndOf="@id/vHeroBg" />

                <!-- Profile block: overlaps hero bottom -->
                <LinearLayout
                    android:id="@+id/llProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="8dp"
                    android:paddingBottom="24dp"
                    app:layout_constraintTop_toBottomOf="@id/vHeroBg"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="-55dp">

                    <FrameLayout
                        android:id="@+id/flAvatarContainer"
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:strokeWidth="3dp"
                            app:strokeColor="@color/bg"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.GithubChat.Circle" />

                        <FrameLayout
                            android:id="@+id/flAvatarInitial"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:background="@drawable/bg_avatar_white_border"
                            android:padding="3dp">
                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_avatar_purple">
                                <TextView
                                    android:id="@+id/tvAvatarInitial"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:textColor="@color/white"
                                    android:textSize="42sp"
                                    android:fontFamily="sans-serif-medium" />
                            </FrameLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvProfileTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/accent"
                        android:textSize="16sp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvProfileStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:hint="@string/settings_status_hint"
                        android:textColorHint="@color/text_tertiary" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/llSettingsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:paddingTop="0dp"
                android:paddingBottom="40dp">

                <!-- ОСНОВНОЕ (GENERAL) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_main"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/itemAccount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:alpha="0.4">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_person" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_main" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemPersonalization"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_palette" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_personalization" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemNotifications"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:alpha="0.4">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_bell" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_notifications" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemStickers"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:alpha="0.4">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_sticker" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_stickers" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemChats"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="false"
                        android:focusable="false"
                        android:enabled="false"
                        android:alpha="0.4">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_chat_bubble" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/chats_title" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                </LinearLayout>

                <!-- БЕЗОПАСНОСТЬ (SECURITY) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_security"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/itemChangePin"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_lock" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_item_change_pin"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_item_change_pin_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemBiometric"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_fingerprint" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_item_biometric"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_item_biometric_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchBiometric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Жёлтое предупреждение: в телефоне нет зарегистрированного отпечатка -->
                <LinearLayout
                    android:id="@+id/warnBiometric"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_warning"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_warning"
                        android:tint="@color/warning"
                        android:layout_marginEnd="12dp"
                        android:layout_marginTop="1dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/biometric_warn_title"
                            android:textColor="@color/warning"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/biometric_warn_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />
                        <TextView
                            android:id="@+id/btnBiometricEnroll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/biometric_open_settings"
                            android:textColor="@color/warning"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:background="@drawable/bg_button_warning_outline"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="9dp"
                            android:layout_marginTop="12dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ЕЩЕ (MORE) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_section_more"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_settings_card"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:id="@+id/itemVersion"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_refresh"
                            android:tint="@color/accent"
                            android:layout_marginEnd="14dp" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/settings_version_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp" />
                            <TextView
                                android:id="@+id/tvVersionSub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvVersionBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            android:textSize="12sp"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemAbout"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_info_outline" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_about" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/itemCredits"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp"
                            android:src="@drawable/ic_heart" android:tint="@color/accent" android:layout_marginEnd="14dp" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/settings_item_credits" android:textColor="@color/text_primary" android:textSize="15sp" />
                        <ImageView android:layout_width="18dp" android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right" android:tint="@color/text_tertiary" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:gravity="center"
                    android:text="@string/settings_logout"
                    android:textColor="@color/error"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Sticky collapsed top bar — fades in on scroll -->
    <LinearLayout
        android:id="@+id/llTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:alpha="0">

        <FrameLayout
            android:id="@+id/flTopBarAvatarInitial"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_purple">
                <TextView
                    android:id="@+id/tvTopBarAvatarInitial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
            </FrameLayout>
        </FrameLayout>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivTopBarAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.GithubChat.Circle" />

        <TextView
            android:id="@+id/tvTopBarName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Back button removed -->


</FrameLayout>
