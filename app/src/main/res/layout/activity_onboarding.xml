<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Шаг 1: Ник -->
    <LinearLayout
        android:id="@+id/step_name"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_name_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_name_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/et_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPersonName|textCapWords"
            android:textSize="16sp"
            android:maxLength="30"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/et_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_tag"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/accent"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textNoSuggestions"
            android:textSize="16sp"
            android:maxLength="30"
            android:importantForAutofill="no"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_next"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Шаг 2: Локальный пароль (опц.) -->
    <LinearLayout
        android:id="@+id/step_password"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_pwd_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_pwd_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/et_pwd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/onboarding_pwd_field"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/et_pwd_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/onboarding_pwd_repeat"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:importantForAutofill="no"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <Button
            android:id="@+id/btn_finish"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_finish"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/btn_skip_pwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/onboarding_pwd_skip"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:padding="14dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</FrameLayout>
