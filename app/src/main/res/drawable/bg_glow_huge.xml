<?xml version="1.0" encoding="utf-8"?>
<!-- Большой "ореол" свечения вокруг крупных иконок (GitHub, дверь).
     Три концентрических круга с разной прозрачностью создают эффект
     soft halo / portal. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Самое внешнее очень мягкое свечение -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#0F9D4EDD" />
        </shape>
    </item>
    <!-- Средний круг -->
    <item
        android:left="14dp" android:top="14dp"
        android:right="14dp" android:bottom="14dp">
        <shape android:shape="oval">
            <solid android:color="#1F9D4EDD" />
        </shape>
    </item>
    <!-- Внутренний круг с тонкой обводкой и тёмным фоном -->
    <item
        android:left="32dp" android:top="32dp"
        android:right="32dp" android:bottom="32dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
            <stroke android:width="1dp" android:color="#5DC77DFF" />
        </shape>
    </item>
</layer-list>
