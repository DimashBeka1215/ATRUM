<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Размытый фон: то же фото в fit-масштабе, полосы — продолжение края (BlurFillView). -->
    <com.atrum.chat.BlurFillView
        android:id="@+id/iv_page_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Само фото: резкое, по центру, края растворяются в фоне (FeatherImageView). -->
    <com.atrum.chat.FeatherImageView
        android:id="@+id/iv_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="matrix"
        android:contentDescription="@null"/>

    <ProgressBar
        android:id="@+id/pb_page"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="visible"/>

</FrameLayout>
