<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/bg_verified_card"
    android:paddingHorizontal="26dp"
    android:paddingTop="30dp"
    android:paddingBottom="26dp">

    <FrameLayout
        android:layout_width="74dp"
        android:layout_height="74dp">

        <View
            android:layout_width="74dp"
            android:layout_height="74dp"
            android:layout_gravity="center"
            android:alpha="0.16"
            android:background="@drawable/bg_verified_glow" />

        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:alpha="0.22"
            android:background="@drawable/bg_verified_glow" />

        <com.atrum.chat.VerifiedBadgeView
            android:id="@+id/verified_hero"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:visibility="gone"
            android:contentDescription="@string/verified_badge_cd" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/verified_dev_title"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/verified_dev_body"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.15"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/verified_dev_note"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:lineSpacingMultiplier="1.1"
        android:gravity="center" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/verified_dev_thanks"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginStart="5dp"
            android:src="@drawable/ic_heart"
            app:tint="@color/accent_light"
            android:contentDescription="@null" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_verified_ok"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_button"
        android:gravity="center"
        android:text="@string/verified_dev_ok"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
