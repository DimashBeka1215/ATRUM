<?xml version="1.0" encoding="utf-8"?>
<!--
    JoinChat — нативная композиция в стиле приложения:
      — атмосферный фон bg_join_screen (OLED black + subtle purple glow)
      — vector neon door illustration (ic_door_neon)
      — карточка/инпут/инфо в стиле приложения (surface, border_subtle, 14-22dp)
      — кнопки — родные bg_button / bg_button_outline (14dp, 56/52dp height)
      — security блок с тонкой lock иконкой
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_join_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp">

        <!-- Back: тонкая light-purple стрелка, без bg -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="-10dp"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_thin" />

        <!-- Заголовок -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:text="@string/join_chat_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/join_chat_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Gap до иллюстрации -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Vector neon portal по центру с поддержкой аватарки -->
        <FrameLayout
            android:layout_width="232dp"
            android:layout_height="232dp"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_door"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/ic_portal_neon" />

            <!-- Аватарка собеседника, появляется когда чат найден -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_partner_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.GithubChat.Circle" />

            <LinearLayout
                android:id="@+id/ll_partner_info_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="invisible">

                <TextView
                    android:id="@+id/tv_partner_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_partner_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/accent"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Gap до карточки -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Карточка с полем пароля и инфо-блоком (app-стилевая) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="18dp">

            <!-- Label "ИНВАЙТ-КОД" -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:text="@string/join_chat_password_label"
                android:textAllCaps="true"
                android:textColor="@color/accent_light"
                android:textSize="11sp" />

            <!-- Input + eye -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/et_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_neon"
                    android:fontFamily="sans-serif"
                    android:hint="@string/join_chat_password_hint"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:letterSpacing="0.02"
                    android:paddingStart="16dp"
                    android:paddingEnd="48dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_toggle_password"
                    android:padding="6dp"
                    android:src="@drawable/ic_eye_thin" />
            </FrameLayout>

            <!-- Info банер -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_info_banner"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_info_thin" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/join_chat_info"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Inline статус: подсказки, ошибки, прогресс этапов подключения -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Gap до главной кнопки -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <!-- Primary кнопка в стиле приложения -->
        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/join_chat_connect"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp" />

        <!-- Gap -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Outline кнопка "Назад" в стиле приложения -->
        <Button
            android:id="@+id/btn_back_bottom"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_button_outline"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/join_chat_back"
            android:textAllCaps="false"
            android:textColor="@color/accent_light"
            android:textSize="14sp" />

        <!-- Gap до security блока -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="26dp" />

        <!-- Security block -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_security_subtle"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock_thin" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/create_chat_footer"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
