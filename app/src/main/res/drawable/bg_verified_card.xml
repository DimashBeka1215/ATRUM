<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка окна верификации (диалог). Surface + тонкая рамка + скругление 22dp. Токены —
     корректно в тёмной/светлой теме. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <corners android:radius="22dp" />
    <stroke android:width="0.5dp" android:color="@color/border" />
</shape>
