<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешний glow — большой полупрозрачный фиолетовый круг -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F9D4EDD" />
        </shape>
    </item>
    <!-- Внутренний круг для иконки -->
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#0A0A0A" />
            <stroke
                android:width="1dp"
                android:color="#3D9D4EDD" />
        </shape>
    </item>
</layer-list>
