<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:minWidth="58dp">

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_mention_avatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.Circle" />

        <TextView
            android:id="@+id/tv_mention_letter"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_placeholder"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_mention_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxWidth="60dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/text_primary"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/tv_mention_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="60dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/accent_light"
        android:textSize="9.5sp" />

</LinearLayout>
