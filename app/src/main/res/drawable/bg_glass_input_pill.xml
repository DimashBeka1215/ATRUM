<?xml version="1.0" encoding="utf-8"?>
<!-- Пилюля поля ввода в режиме «атмосферное стекло».
     Заливка chat_input_pill — всего 30% чёрного (тёмная тема), на тёмных обоях
     капсула сливалась с фоном и её границы читались только по содержимому.
     Обводка 1dp #26FFFFFF (15% белого) очерчивает её на ЛЮБЫХ обоях, не добавляя веса. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/chat_input_pill"/>
    <corners android:radius="32dp"/>
    <stroke android:width="1dp" android:color="#26FFFFFF"/>
</shape>
