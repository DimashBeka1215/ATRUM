<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Чтобы Service мог открыть Activity поверх Custom Tabs после успеха OAuth -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Системная биометрия (отпечаток). Приложение не хранит биометрию,
         только вызывает системный BiometricPrompt телефона. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:largeHeap="true"
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GithubChat"
        tools:targetApi="33">

        <activity
            android:name=".IntroActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatsListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CreditsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".CreateChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".JoinChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ImageViewActivity"
            android:exported="false"
            android:theme="@style/Theme.GithubChat" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PersonalizationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WallpaperPreviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- EULA — пользовательское соглашение, показывается при первом запуске -->
        <activity
            android:name=".EulaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Профиль собеседника -->
        <activity
            android:name=".PartnerProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.GithubChat" />

        <!-- Экран краша — открывается вместо системного диалога "Приложение остановлено" -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GithubChat" />


        <!-- HeaderSettingsActivity — настройка баннера профиля -->
        <activity
            android:name=".HeaderSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".stickers.StickerSettingsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".stickers.StickerGuideActivity"
            android:exported="false"
            android:theme="@style/Theme.GithubChat" />

        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ChangePinActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- uCrop activity для кропа аватарок -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Фоновый сервис пушей: тихо опрашивает реле и шлёт анонимный пуш о новом сообщении -->
        <service
            android:name=".MessageWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Перезапуск сервиса после перезагрузки телефона -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
