<?xml version="1.0" encoding="utf-8"?>
<!--
    Карточка степпера срока действия приглашения (обычное состояние, 1-24ч).
    surface_elevated + border_subtle — как остальные вложенные карточки в диалогах.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <stroke
        android:width="1dp"
        android:color="@color/border_subtle" />
    <corners android:radius="14dp" />
</shape>
