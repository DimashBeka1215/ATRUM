    <string name="intro_1_title">Welcome</string>
    <string name="intro_1_subtitle">A private messenger for two people.\nNo servers. No ads. No logs.</string>

    <string name="intro_2_title">End-to-end encryption</string>
    <string name="intro_2_subtitle">Messages are encrypted right on your device.\nThe room password never leaves your phone. Nobody but your contact can read your messages.</string>

    <string name="intro_3_title">What is GitHub Gist?</string>
    <string name="intro_3_subtitle">A Gist is a small note on GitHub. We use it as an encrypted mailbox — only encrypted strings are stored there. GitHub sees ciphertext, not your messages.</string>

    <string name="intro_4_title">Experimental Beta</string>
    <string name="intro_4_subtitle">This is a closed beta. Some features may be unstable.\nUse with care and not for critical conversations.</string>

