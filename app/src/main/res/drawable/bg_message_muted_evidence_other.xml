<?xml version="1.0" encoding="utf-8"?>
<!-- Пузырёк собеседника внутри ленты сообщений-оснований мута (ветка-переписка может
     включать реплику ДРУГОГО человека, см. ChatActivity.addMuteEvidenceBubble) — нейтральная
     (не жёлтая) заливка, чтобы не выглядело так, будто это сказал сам заглушённый. Хвост
     скругления зеркальный относительно bg_message_muted_evidence (снизу-слева, т.к. пузырёк
     прижат к левому краю). @color/surface_elevated — опаque токен, безопасен в обеих темах. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/surface_elevated" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="20dp" />
</shape>
