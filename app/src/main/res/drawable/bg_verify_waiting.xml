<?xml version="1.0" encoding="utf-8"?>
<!--
    Плашка сверки в состоянии «ждём собеседника»: мягкая акцентная подложка с обводкой.
    Альфа-оттенки акцента (#9D4EDD) задаём здесь напрямую — как и в bg_warning, потому что
    к @color-токену нельзя применить прозрачность в shape. Работает в обеих темах.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A9D4EDD" />
    <stroke android:width="1dp" android:color="#559D4EDD" />
    <corners android:radius="11dp" />
</shape>
