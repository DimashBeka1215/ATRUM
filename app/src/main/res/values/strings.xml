    <!-- Intro pager (4 экрана) -->
    <string name="intro_donate_title">Support the Project</string>
    <string name="intro_donate_subtitle">Atrum is built by one person, with no funding or ads. If you enjoy the app, please consider supporting its development — every donation, big or small, keeps this project alive.\n\nYou can donate anytime via Settings → Support.</string>
    <string name="intro_skip">Пропустить</string>
    <string name="intro_next">Далее</string>
    <string name="intro_get_started">Начать</string>

    <string name="intro_1_title">Добро пожаловать</string>
    <string name="intro_1_subtitle">Приватный мессенджер для двух людей.\nБез серверов. Без рекламы. Без логов.</string>

    <string name="intro_2_title">End-to-end шифрование</string>
    <string name="intro_2_subtitle">Сообщения шифруются прямо на твоём устройстве.\nПароль комнаты не покидает телефон. Никто кроме собеседника не сможет прочитать твою переписку.</string>

    <string name="intro_3_title">Что такое GitHub Gist?</string>
    <string name="intro_3_subtitle">Gist — это маленькая заметка на GitHub. Мы используем её как зашифрованный почтовый ящик: туда летят только зашифрованные строки. GitHub видит шифр, не текст.</string>

    <string name="intro_4_title">Experimental Beta</string>
    <string name="intro_4_subtitle">Это закрытая бета. Некоторые функции работают нестабильно.\nИспользуй осторожно и не для критичных переписок.</string>

    <string name="badge_beta">EXPERIMENTAL BETA</string>

