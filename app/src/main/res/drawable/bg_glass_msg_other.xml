<?xml version="1.0" encoding="utf-8"?>
<!-- Пузырёк собеседника в режиме «атмосферное стекло».
     Тёмно-фиолетовое стекло 70% (#231436) вместо прежнего белого 17% (#2BFFFFFF):
     белое стекло было невидимо на светлых обоях и втрое слабее своего пузырька
     (#806B26B6 = 50%). Тёмная подложка даёт контраст белому тексту на ЛЮБЫХ обоях
     (≈6.4:1 на светлом фото, ≈19:1 на тёмном) и остаётся в фиолетовой семье.
     Обводка — как у своего пузырька (#40C77DFF), для родства двух сторон. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#B3231436"/>
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="20dp"/>
    <stroke android:width="1dp" android:color="#40C77DFF"/>
</shape>
