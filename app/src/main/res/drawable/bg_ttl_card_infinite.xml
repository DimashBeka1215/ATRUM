<?xml version="1.0" encoding="utf-8"?>
<!--
    Карточка степпера срока действия — состояние "Без ограничений".
    Тот же жёлтый акцент, что и bg_warning (10%/24% от @color/warning #FFB454) —
    сознательно привлекает внимание к security-значимому выбору "не истекает".
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1AFFB454" />
    <stroke
        android:width="1dp"
        android:color="#3DFFB454" />
    <corners android:radius="14dp" />
</shape>
