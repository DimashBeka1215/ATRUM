<?xml version="1.0" encoding="utf-8"?>
<!--
    CreateChat — 2 экрана с переключением:
      1) choice_screen   — стартовый: 2 карточки (Создать P2P / Присоединиться)
      2) github_form     — форма создания P2P-чата (avatar + features + chips),
                           показывается после клика "Создать P2P-чат"
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_join_screen"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="32dp">

        <!-- ====== ОБЩИЙ HEADER: back + title + EXPERIMENTAL BETA ====== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btn_back_to_choice"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="-10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back_thin"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="@string/create_chat_title"
                android:textColor="@color/text_primary"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_beta_badge"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:paddingHorizontal="9dp"
                android:paddingVertical="5dp"
                android:text="@string/badge_beta"
                android:textColor="@color/warning"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Subtitle — только на choice экране -->
        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:fontFamily="sans-serif"
            android:text="@string/create_chat_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- ====== CHOICE SCREEN (стартовый) ====== -->
        <LinearLayout
            android:id="@+id/choice_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO: P2P карточка -->
            <LinearLayout
                android:id="@+id/card_p2p"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_hero"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="28dp">

                <FrameLayout
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginBottom="20dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glow_huge" />

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_p2p_network"
                        app:tint="@color/text_primary" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/create_card_p2p_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="22dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/create_card_p2p_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_button"
                    android:clickable="false"
                    android:duplicateParentState="true"
                    android:focusable="false"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="@string/create_card_p2p_cta"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Карточка "Присоединиться к существующему чату" -->
            <LinearLayout
                android:id="@+id/card_join"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_link_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_people"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/create_card_join_title"
                        android:textColor="@color/accent_light"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_card_join_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/accent" />
            </LinearLayout>

            <!-- Карточка "Подключиться по Bluetooth" (сканировать QR рядом) -->
            <LinearLayout
                android:id="@+id/card_bt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_link_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bluetooth"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/create_card_bt_title"
                        android:textColor="@color/accent_light"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/create_card_bt_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/accent" />
            </LinearLayout>

            <!-- "или" разделитель -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:paddingHorizontal="16dp"
                    android:text="@string/create_card_or"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/border" />
            </LinearLayout>


            <Button
                android:id="@+id/btn_cancel_choice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="?attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="@string/btn_cancel"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Футер -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:gravity="start"
                    android:text="@string/create_chat_footer"
                    android:textColor="@color/text_tertiary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ====== P2P FORM (новый premium дизайн) ====== -->
        <LinearLayout
            android:id="@+id/p2p_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Avatar preview: вращающееся неон-кольцо (портал) + аватар (неподвижен) -->
            <FrameLayout
                android:id="@+id/fl_avatar_container"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="44dp">

                <!-- Неон-кольцо портала (как в окне приглашения) — медленно вращается из кода. -->
                <ImageView
                    android:id="@+id/iv_avatar_portal"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_portal_neon" />

                <!-- Аватарка — неподвижна -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_user_silhouette"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.Circle" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_avatar_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/cc_group_avatar_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/cc_profile_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_profile_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:paddingHorizontal="32dp"
                android:text="@string/cc_profile_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Переключатель: обычный / групповой чат (экспериментально, UI) -->
            <LinearLayout
                android:id="@+id/chat_mode_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_input"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/toggle_pair"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/cc_mode_pair"
                    android:textColor="@color/accent_light"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/toggle_group"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_chip_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/cc_mode_group"
                    android:textColor="@color/text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Название чата — только для группового режима -->
            <LinearLayout
                android:id="@+id/group_name_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="@string/cc_group_name_label"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/et_group_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="@string/cc_group_name_hint"
                    android:inputType="textCapSentences"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="13dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_quaternary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Максимум участников — только для группового режима -->
            <LinearLayout
                android:id="@+id/group_participants_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.10"
                    android:text="@string/cc_group_participants_label"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_part_5"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/cc_part_5"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_part_10"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/cc_part_10"
                        android:textColor="@color/accent_light"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_part_15"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/cc_part_15"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chip_part_unlim"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip_default"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="@string/cc_part_unlim"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_participants_helper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Info card (2 features) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_card_hero"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_feature1_icon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_people_pair" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_feature1_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cc_feature_exchange_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_feature1_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="1dp"
                            android:text="@string/cc_feature_exchange_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="68dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_profile_exchange" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_marginEnd="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield_check" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/cc_feature_e2e_title"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:lineSpacingExtra="1dp"
                            android:text="@string/cc_feature_e2e_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock_thin" />
                </LinearLayout>
            </LinearLayout>

            <!-- Yellow info: invite-only, custom password in advanced mode -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_warning"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cc_invite_only_title"
                        android:textColor="@color/warning"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tv_invite_only_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/cc_invite_only_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>


            <!-- Duration chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:text="@string/cc_duration_label"
                android:textAllCaps="true"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_1d"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/cc_duration_1d"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_7d"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/cc_duration_7d"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_30d"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_default"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/cc_duration_30d"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/chip_unlim"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_default"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="@string/cc_duration_unlim"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/cc_duration_helper"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <!-- Путь сообщений: Nostr напрямую / через Tor (иконки) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.10"
                android:text="@string/cc_path_label"
                android:textAllCaps="true"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/path_nostr"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_path_nostr">

                    <ImageView
                        android:id="@+id/path_nostr_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_flash"
                        app:tint="@color/text_secondary" />
                </FrameLayout>
                <FrameLayout
                    android:id="@+id/path_tor"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_path_tor">

                    <ImageView
                        android:id="@+id/path_tor_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/text_secondary" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/path_bt"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_default"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/cd_path_bt">

                    <ImageView
                        android:id="@+id/path_bt_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bluetooth"
                        app:tint="@color/text_secondary" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_path_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/cc_path_desc_nostr"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <!-- Tor Warning (Experimental) -->
            <LinearLayout
                android:id="@+id/tor_warning_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_warning"
                android:orientation="horizontal"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/warning" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/cc_tor_experimental_title"
                        android:textColor="@color/warning"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/cc_tor_experimental_text"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bt_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_settings_card"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bt_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bt_searching"
                    android:textColor="@color/accent_light"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/bt_search_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/bt_device_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_bt_show_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:drawableStart="@drawable/ic_qr"
                    android:drawablePadding="8dp"
                    android:gravity="center_vertical"
                    android:padding="8dp"
                    android:text="@string/bt_show_my_qr"
                    android:textColor="@color/accent_light"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/iv_bt_qr"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/bt_show_my_qr"
                    android:visibility="gone" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_create_p2p"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_button"
                android:drawableEnd="@drawable/ic_sparkle"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:paddingHorizontal="22dp"
                android:stateListAnimator="@null"
                android:text="@string/cc_create_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bt_wait"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="64dp"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <ImageView
                android:id="@+id/iv_bt_wait_avatar"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="20dp"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/bt_wait_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="@string/bt_wait_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/bt_wait_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/bt_wait_hint"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
