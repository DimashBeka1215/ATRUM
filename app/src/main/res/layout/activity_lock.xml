<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_lock"
        android:contentDescription="@null"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lock_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lock_hint"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="28dp"/>

    <EditText
        android:id="@+id/et_pwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/lock_field"
        android:textColorHint="@color/text_tertiary"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:inputType="textPassword"
        android:textSize="16sp"
        android:imeOptions="actionDone"
        android:layout_marginBottom="20dp"
        android:importantForAutofill="no"/>

    <Button
        android:id="@+id/btn_unlock"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/lock_use_pin"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button"
        android:stateListAnimator="@null"
        android:textAllCaps="false"/>

    <!-- Разделитель "или" — виден только если включён вход по отпечатку -->
    <LinearLayout
        android:id="@+id/or_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone">
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_or"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:layout_marginHorizontal="12dp"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/border"/>
    </LinearLayout>

    <!-- Кнопка входа по отпечатку — видна только если включён вход по отпечатку -->
    <LinearLayout
        android:id="@+id/btn_biometric"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="6dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:src="@drawable/ic_fingerprint"
            android:tint="@color/accent"
            android:padding="15dp"
            android:background="@drawable/bg_biometric_circle"
            android:contentDescription="@string/lock_use_fingerprint"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_use_fingerprint"
            android:textColor="@color/accent_light"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</LinearLayout>
