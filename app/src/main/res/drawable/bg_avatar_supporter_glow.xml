<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Внешнее размытое свечение -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#28C77DFF" />
        </shape>
    </item>
    <!-- Средний ореол -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#40C77DFF" />
        </shape>
    </item>
    <!-- Тонкое кольцо вплотную к аватару -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="1.5dp"
                android:color="#80C77DFF" />
        </shape>
    </item>
</layer-list>
