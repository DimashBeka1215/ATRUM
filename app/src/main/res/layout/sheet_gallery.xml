<?xml version="1.0" encoding="utf-8"?>
<!-- Своя галерея-шторка (bottom sheet). НЕ чат-экран → только непрозрачные токены
     @color/surface / @color/text_* (glass здесь не применяется). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet_top">

    <!-- Грабер -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_grabber" />

    <!-- Шапка -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="10dp">

        <!-- Заголовок = кнопка выбора альбома (title + шеврон) -->
        <LinearLayout
            android:id="@+id/gallery_title_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="4dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/gallery_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <ImageView
                android:id="@+id/gallery_chevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_down"
                android:contentDescription="@null"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/gallery_pick_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/gallery_pick_more"
            android:textColor="@color/accent"
            android:textSize="13.5sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/gallery_close"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_icon_button"
            android:padding="7dp"
            android:contentDescription="@string/gallery_close_cd"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Сетка фото + заглушка -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gallery_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="1dp"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/gallery_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/gallery_empty"
            android:textColor="@color/text_tertiary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />

        <!-- Затемнение под выпадашкой альбомов (тап закрывает) -->
        <View
            android:id="@+id/gallery_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#59000000"
            android:visibility="gone" />

        <!-- Выпадающий список альбомов — компактная карточка под заголовком -->
        <com.atrum.chat.MaxHeightScrollView
            android:id="@+id/gallery_albums_scroll"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_album_dropdown"
            android:clipToOutline="true"
            android:elevation="8dp"
            android:paddingVertical="5dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/gallery_albums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.atrum.chat.MaxHeightScrollView>
    </FrameLayout>

    <!-- Панель отправки: показывается, только когда есть выбор -->
    <LinearLayout
        android:id="@+id/gallery_send_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp"
        android:background="@color/surface"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gallery_send_btn"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_send"
                android:contentDescription="@null"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/gallery_send_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gallery_title"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
