<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:paddingVertical="2dp">

    <!-- Чипы реакций: появляются под пузырьком, выровнены по правому краю -->
    <LinearLayout
        android:id="@+id/reaction_row"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="1dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_message_self"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:minWidth="120dp"
        android:maxWidth="280dp">

        <!-- Блок цитаты -->
        <LinearLayout
            android:id="@+id/quote_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_quote_self"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:background="@color/accent_light"
                android:layout_marginEnd="8dp"
                android:minHeight="28dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_quote_sender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent_light"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tv_quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp"
                    android:maxLines="2"
                    android:ellipsize="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Анимированный стикер (.tgs / Lottie) или статический -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_sticker"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:background="@null"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <!-- Видео-стикер (.webm / VP9) — ExoPlayer -->
        <com.atrum.chat.WebmStickerView
            android:id="@+id/webm_sticker"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

                <!-- Одиночная картинка -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_image"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="centerCrop"
            android:maxHeight="320dp"
            android:contentDescription="@null"
            android:visibility="gone"
            android:layout_marginBottom="4dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.RoundedImage"/>

        <!-- Коллаж из нескольких изображений -->
        <com.atrum.chat.CollageLayout
            android:id="@+id/collage_layout"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <!-- Голосовое сообщение -->
        <LinearLayout
            android:id="@+id/voice_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minWidth="0dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">
                <ProgressBar
                    android:id="@+id/voice_progress_ring"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_voice_ring"
                    android:visibility="gone" />
                <FrameLayout
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_voice_circle_white">
                    <ImageButton
                        android:id="@+id/btn_voice_play"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_play"
                        android:background="@null"
                        android:scaleType="centerInside"
                        android:padding="7dp"
                        android:contentDescription="@string/cd_voice_play"
                        app:tint="@color/msg_self" />
                    <ProgressBar
                        android:id="@+id/voice_spinner"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/msg_self"
                        android:visibility="gone" />
                </FrameLayout>
            </FrameLayout>
            <com.atrum.chat.WaveformView
                android:id="@+id/voice_waveform"
                android:layout_width="60dp"
                android:layout_height="22dp"
                android:layout_marginHorizontal="8dp" />
            <TextView
                android:id="@+id/tv_voice_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="2dp"
            android:maxWidth="260dp"
            android:breakStrategy="simple"
            android:hyphenationFrequency="normal"/>

        <LinearLayout
            android:id="@+id/link_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:maxWidth="264dp"
            android:background="@drawable/bg_link_preview"
            android:padding="9dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="9dp"
                android:background="@drawable/bg_link_preview_bar" />

            <ImageView
                android:id="@+id/lp_globe"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_link"
                android:tint="@color/text_tertiary"
                android:visibility="gone"
                android:contentDescription="@null" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/lp_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lp_site"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent_light"
                        android:textSize="12.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/lp_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/lp_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lp_skel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View android:layout_width="90dp" android:layout_height="10dp"
                        android:layout_marginBottom="7dp" android:background="@drawable/bg_lp_skel" />
                    <View android:layout_width="170dp" android:layout_height="11dp"
                        android:layout_marginBottom="6dp" android:background="@drawable/bg_lp_skel" />
                    <View android:layout_width="120dp" android:layout_height="10dp"
                        android:background="@drawable/bg_lp_skel" />
                </LinearLayout>
            </FrameLayout>

            <ImageView
                android:id="@+id/lp_thumb"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_photo_cell"
                android:clipToOutline="true"
                android:visibility="gone"
                android:contentDescription="@null" />

            <View
                android:id="@+id/lp_skel_thumb"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_lp_skel"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="2dp">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_light"
                android:textSize="10sp"
                android:fontFamily="sans-serif"/>

            <ImageView
                android:id="@+id/iv_tick"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                app:tint="@color/accent_light"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
