<?xml version="1.0" encoding="utf-8"?>
<!-- Мини-превью выбранного фото в баре над вводом: миниатюра + крестик «убрать». -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/staged_img"
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:scaleType="centerCrop"
        android:background="@color/surface_elevated"
        android:contentDescription="@null"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.RoundedImage" />

    <ImageView
        android:id="@+id/staged_remove"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_staged_remove"
        android:padding="4dp"
        android:contentDescription="@string/gallery_remove_cd"
        app:tint="@color/white" />
</FrameLayout>
