<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back_thin" />

        <!-- Avatar block -->
        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_placeholder" />

            <TextView
                android:id="@+id/tv_avatar_initial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="38sp"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_profile_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@null"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.AtrumChat.Circle" />

            <!-- Демо-группа (см. PartnerProfileActivity.EXTRA_DEMO_GROUP): смена аватара
                 чата админом. Скрыт для обычного (не групповое, не админ) профиля. -->
            <ImageButton
                android:id="@+id/btn_avatar_edit_demo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_edit_avatar_btn"
                android:padding="7dp"
                android:src="@drawable/ic_pencil"
                android:contentDescription="@string/cd_group_avatar"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Name — во всю ширину, центрируется по КАЖДОЙ строке (не обрезается, переносится).
             Раньше жила в горизонтальном wrap_content-ряду вместе с иконками — на длинных
             (переносящихся на 2+ строки) названиях это ломало центрирование и выталкивало
             карандаш редактирования за экран (см. фикс: иконки переехали в отдельные строки
             ниже, каждая сама по себе центрирована — не зависят от ширины текста). -->
        <TextView
            android:id="@+id/tv_profile_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="32dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />

        <!-- Shield статуса безопасности (1:1, верифицированный собеседник). -->
        <ImageButton
            android:id="@+id/btn_shield_status"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:padding="5dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/text_primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="@string/profile_security_label" />

        <!-- Группа (демо/реальная): переименование чата админом. -->
        <ImageButton
            android:id="@+id/btn_name_edit_demo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:src="@drawable/ic_pencil"
            app:tint="@color/text_secondary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            android:contentDescription="@string/cc_group_name_label" />

        <!-- Tag -->
        <TextView
            android:id="@+id/tv_profile_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:textColor="@color/accent"
            android:textSize="14sp" />

        <!-- Группа (реальная, ADR-001): описание чата. Видна у всех, если описание
             заполнено; у админа видна всегда — с плейсхолдером-приглашением, если
             пусто, и карандашом редактирования. Публикуется через тот же
             подписанный members.txt, что имя/аватар группы (см. MembersSync). -->
        <LinearLayout
            android:id="@+id/card_group_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_group_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp" />

            <ImageButton
                android:id="@+id/btn_group_description_edit"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:padding="6dp"
                android:src="@drawable/ic_pencil"
                app:tint="@color/text_tertiary"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:contentDescription="@string/cd_group_description_edit" />
        </LinearLayout>

        <!-- Демо-группа: переключатель роли предпросмотра (Участник/Админ).
             НЕ показывается в реальном 1:1-профиле — только когда экран открыт
             через TesterSettingsActivity.EXTRA_DEMO_GROUP. -->
        <LinearLayout
            android:id="@+id/demo_role_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/demo_role_member"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/demo_role_member"
                android:textColor="@color/accent_light"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/demo_role_admin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_chip_default"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingVertical="9dp"
                android:text="@string/demo_role_admin"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/profile_status_label"
                android:textAllCaps="true"
                android:textColor="@color/accent_light"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Демо-группа: список участников (виден только админу). Строки добавляются
             программно в PartnerProfileActivity.buildDemoMembers() — id ll_members_container. -->
        <LinearLayout
            android:id="@+id/section_members"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginBottom="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.08"
                android:text="@string/group_members_label"
                android:textAllCaps="true"
                android:textColor="@color/text_tertiary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/ll_members_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Security section — скрыта, раскрывается по тапу на щит -->
        <LinearLayout
            android:id="@+id/card_security"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_card"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="@string/profile_security_label"
                android:textAllCaps="true"
                android:textColor="@color/accent_light"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/ll_identity_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/iv_security_badge"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_shield_check"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/tv_security_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="13sp"
                    android:text="@string/identity_unverified" />
            </LinearLayout>

            <!-- Плашка взаимной сверки: «ждём собеседника» → живьём «подтверждено обоими». -->
            <LinearLayout
                android:id="@+id/ll_verify_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="11dp"
                android:background="@drawable/bg_verify_waiting"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/iv_verify_status_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="11dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/accent_light"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_verify_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:text="@string/verify_status_waiting_title" />
                    <TextView
                        android:id="@+id/tv_verify_status_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:text="@string/verify_status_waiting_sub" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_security_fingerprint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:text="@string/fingerprint_loading" />

            <ImageView
                android:id="@+id/iv_security_qr"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_marginTop="14dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_qr_white"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:contentDescription="@string/fingerprint_description" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                android:text="@string/fingerprint_description"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/warn_identity_changed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_error_card"
                android:padding="12dp"
                android:layout_marginTop="14dp"
                android:visibility="gone">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/error"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/identity_changed_warn"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_verify_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/verify_hint"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_verify"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/verify_confirm_btn"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:textAllCaps="false"
                android:background="@drawable/bg_button"
                android:stateListAnimator="@null"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Photos section -->
        <LinearLayout
            android:id="@+id/section_photos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Заголовок: "Фото" + счётчик + ссылка "все" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="9dp"
                    android:src="@drawable/ic_image_outline"
                    android:tint="@color/accent"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/profile_photos_label"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_photos_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/btn_photos_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_photos_all"
                        android:textColor="@color/accent"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_chevron_right"
                        android:tint="@color/accent"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- Один ряд из 3 плиток -->
            <LinearLayout
                android:id="@+id/ll_photo_grid_row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="21dp"
                android:weightSum="3" />
        </LinearLayout>

            <!-- profile_voice_label section -->
            <LinearLayout
                android:id="@+id/section_voice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/accent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/profile_voice_label"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_voice_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/btn_voice_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_photos_all"
                            android:textColor="@color/accent"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/accent"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_voice_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp" />
            </LinearLayout>

            <!-- profile_links_label section -->
            <LinearLayout
                android:id="@+id/section_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="9dp"
                        android:src="@drawable/ic_link"
                        android:tint="@color/accent"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/profile_links_label"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tv_links_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/btn_links_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_photos_all"
                            android:textColor="@color/accent"
                            android:textSize="13sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="2dp"
                            android:src="@drawable/ic_chevron_right"
                            android:tint="@color/accent"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_links_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp" />
            </LinearLayout>

    </LinearLayout>
</ScrollView>
