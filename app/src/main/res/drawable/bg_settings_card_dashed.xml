<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка удалённого сообщения на экране статистики — тот же bg_settings_card, но
     пунктирная рамка (визуально отличает "удалено" от обычных сообщений в списке). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface"/>
    <stroke android:width="1dp" android:color="@color/border" android:dashWidth="4dp" android:dashGap="3dp"/>
    <corners android:radius="20dp"/>
</shape>
