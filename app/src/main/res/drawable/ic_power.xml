<?xml version="1.0" encoding="utf-8"?>
<!-- Символ питания: разомкнутая дуга + вертикальная черта сверху.
     Контурная (§9, DESIGN.md §5), 24dp. Цвет задаётся через app:tint на ImageView,
     здесь нейтральный @color/text_primary — без hardcode-фиолетового. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/text_primary">

    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/text_primary"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M12,4.5 V11.5" />

    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/text_primary"
        android:strokeWidth="1.9"
        android:strokeLineCap="round"
        android:pathData="M7.6,7.1 A6.6,6.6 0 1,0 16.4,7.1" />
</vector>
