<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Step 1: Current PIN -->
    <LinearLayout
        android:id="@+id/step_old_pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_lock_thin"
            app:tint="@color/accent"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_old_pin_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_item_change_pin_desc"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/et_old_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/onboarding_pwd_field"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:importantForAutofill="no"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <Button
            android:id="@+id/btn_next_to_new"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_next"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Step 2: New PIN -->
    <LinearLayout
        android:id="@+id/step_new_pin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/accent"
            android:layout_marginBottom="24dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_new_pin_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_pwd_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="32dp"/>

        <EditText
            android:id="@+id/et_new_pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/onboarding_pwd_field"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:layout_marginBottom="12dp"
            android:importantForAutofill="no"/>

        <EditText
            android:id="@+id/et_new_pin_repeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/onboarding_pwd_repeat"
            android:textColorHint="@color/text_tertiary"
            android:textColor="@color/text_primary"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:inputType="textPassword"
            android:textSize="16sp"
            android:importantForAutofill="no"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <Button
            android:id="@+id/btn_save_pin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/btn_save"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button"
            android:stateListAnimator="@null"
            android:textAllCaps="false"/>

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/btn_cancel"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:padding="14dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>
</FrameLayout>
