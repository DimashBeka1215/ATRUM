<?xml version="1.0" encoding="utf-8"?>
<!-- Полноэкранное окно входящего предложения передачи владения (ADR §10). Мокап одобрен.
     Появляется у получателя, когда приходит оффер. Приём → полоса загрузки → возврат в чат. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="30dp">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_transfer_icon"
            android:layout_marginBottom="22dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_crown"
                app:tint="@color/accent_light"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transfer_offer_title"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_offer_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/transfer_offer_desc"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="32dp" />

        <!-- Кнопки (оффер) -->
        <LinearLayout
            android:id="@+id/offer_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/btn_offer_accept"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="@drawable/bg_button"
                android:text="@string/transfer_offer_accept"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="11dp" />

            <TextView
                android:id="@+id/btn_offer_decline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center"
                android:background="@drawable/bg_button_outline"
                android:text="@string/transfer_offer_decline"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Загрузка (после «Принять») -->
        <LinearLayout
            android:id="@+id/offer_loading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="@string/transfer_offer_accepting"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/pb_accept"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:progressDrawable="@drawable/bg_progress_bar"
                android:max="100"
                android:progress="0" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
